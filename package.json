{
  "name": "ai-recruitflow",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev:api": "node scripts/workspace/python.mjs -m uvicorn app.main:app --host 127.0.0.1 --port 8000",
    "dev:web": "npm run dev --workspace frontend",
    "db:upgrade": "node scripts/workspace/python.mjs -m alembic upgrade head",
    "db:check": "node scripts/workspace/python.mjs -m alembic check",
    "deploy:config": "node scripts/deploy/compose.mjs config --quiet",
    "ops:backup": "node scripts/workspace/python.mjs -m scripts.operations.backup backup",
    "ops:restore": "node scripts/workspace/python.mjs -m scripts.operations.backup restore",
    "ops:user": "node scripts/workspace/python.mjs -m scripts.admin.users",
    "contracts:export": "node scripts/workspace/python.mjs -m scripts.contracts.export",
    "contracts:generate": "npm run contracts:export && openapi-typescript contracts/openapi.yaml -o frontend/src/types/api.generated.ts",
    "contracts:check": "node scripts/contracts/check.mjs",
    "typecheck": "pyright && npm run typecheck --workspace frontend",
    "lint": "node scripts/workspace/python.mjs -m ruff check app tests scripts alembic && npm run lint --workspace frontend",
    "test": "npm run test:api && npm run test:web",
    "test:api": "node scripts/workspace/python.mjs -m pytest -q",
    "test:web": "npm run test --workspace frontend",
    "smoke:http": "node scripts/workspace/python.mjs -m scripts.smoke.http",
    "smoke:workbench": "node scripts/workspace/python.mjs -m scripts.smoke.workbench",
    "smoke:wecom": "node scripts/workspace/python.mjs -m scripts.smoke.wecom",
    "smoke:security": "node scripts/workspace/python.mjs -m scripts.smoke.security",
    "smoke:sync-failure": "node scripts/workspace/python.mjs -m scripts.smoke.sync_failure",
    "demo:seed": "node scripts/workspace/python.mjs -m scripts.demo.seed",
    "demo:isolated": "node scripts/workspace/python.mjs -m scripts.acceptance.demo",
    "acceptance": "node scripts/workspace/python.mjs -m scripts.acceptance.release",
    "integrations:tencent:discover": "node scripts/workspace/python.mjs -m scripts.integrations.tencent_discover",
    "build": "npm run build --workspace frontend",
    "check": "npm run contracts:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "openapi-typescript": "^7.10.1",
    "pyright": "^1.1.407",
    "typescript-eslint": "^8.46.0"
  }
}
