APP_ENV=development
APP_MODE=mock
DATABASE_URL=sqlite:///./recruitflow.db
APP_TIMEZONE=Asia/Shanghai
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# S0 refuses production/hybrid/live. The fixed local-mock actor is not production authentication.
# APP_TIMEZONE is the future business-date setting; S0 displays Asia/Shanghai, stores UTC.
# The following are optional ONLY for future live integration; NEVER commit real secrets.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
TENCENT_DOCS_MCP_URL=https://docs.qq.com/openapi/mcp
TENCENT_DOCS_TOKEN=
TENCENT_DOCS_FILE_ID=
TENCENT_DOCS_SHEET_ID=
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_CALLBACK_TOKEN=
WECOM_ENCODING_AES_KEY=
