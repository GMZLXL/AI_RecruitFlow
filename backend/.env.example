APP_ENV=development
APP_MODE=mock
DATABASE_URL=sqlite:///./recruitflow.db
APP_TIMEZONE=Asia/Shanghai
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# S5 allows mock/hybrid development only; production/live still refuse startup.
# Optional synthetic fixtures: run npm run demo:seed in development+mock, SmartSheet mock only.
AI_PROVIDER=mock
DEEPSEEK_TIMEOUT_SECONDS=15
DEV_AUTH_ENABLED=true
DEV_DEFAULT_USER=admin
# X-Dev-User selects a server-side synthetic user: admin/hr-a/hr-b/manager-a.
# No browser-supplied role is trusted. This switch has no effect in production.
# API stores/returns UTC; frontend displays Asia/Shanghai.
# For explicit DeepSeek tests: APP_MODE=hybrid, AI_PROVIDER=deepseek and real server-side key.
# Missing DeepSeek credentials enter manual review. NEVER commit secrets.
# Tencent provider never falls back to mock; credentials/schema must be verified before real writes.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
TENCENT_DOCS_MCP_URL=https://docs.qq.com/openapi/mcp
TENCENT_DOCS_TOKEN=
TENCENT_DOCS_FILE_ID=
TENCENT_DOCS_SHEET_ID=
# S3 defaults: periodic in-process worker (one API process), mock projection only.
SMARTSHEET_PROVIDER=mock
SYNC_WORKER_ENABLED=true
# Local deterministic fault injection: none | timeout | after_write_timeout | permission
MOCK_SHEET_FAILURE=none
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_CALLBACK_TOKEN=
WECOM_ENCODING_AES_KEY=
# mock is isolated; real callbacks/sends require explicit hybrid + wecom + enabled flags.
WECOM_PROVIDER=mock
WECOM_CALLBACK_ENABLED=false
WECOM_SEND_ENABLED=false
WECOM_WORKER_ENABLED=true
# Reminder thresholds/enabled state are administrator configuration in DB, initially disabled.
